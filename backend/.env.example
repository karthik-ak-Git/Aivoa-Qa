# Application
APP_NAME=PharmaQMS AI Copilot
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_PROJECT_ID=your_project_id

# Database (Supabase PostgreSQL direct connection)
DATABASE_URL=postgresql+asyncpg://postgres:your_db_password@db.your-project-id.supabase.co:5432/postgres

# Groq API (fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=2048

# OpenRouter API (primary — free models available)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_TEMPERATURE=0.3
OPENROUTER_MAX_TOKENS=2048

# Embedding
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Vector Store
VECTOR_DB_PATH=./data/chroma_db
VECTOR_COLLECTION_NAME=pharmaqms_knowledge
CHUNK_SIZE=512
CHUNK_OVERLAP=100

# Knowledge Base
KNOWLEDGE_BASE_PATH=../../knowledge-base

# Logging
LOG_LEVEL=INFO

# Timeouts
LLM_TIMEOUT=60
RETRIEVAL_TIMEOUT=30
